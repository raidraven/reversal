# データベース(PostgreSQLの接続文字列。例: Neon/Supabase/Vercel Postgresなど)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# NextAuth(`openssl rand -base64 32` などで生成した値を設定)
NEXTAUTH_SECRET="your-nextauth-secret-here"
# 本番では実際の公開URL(https://...)に差し替える
NEXTAUTH_URL="http://localhost:3000"

# Claude API(AIコンパニオン「クロエ」用)
ANTHROPIC_API_KEY="sk-ant-..."

# 館の主(管理者)に自動昇格させるメールアドレス(カンマ区切り、複数可)
# ここに書いたメールでログインすると自動的に /admin ページが閲覧可能になる
ADMIN_EMAILS="you@example.com"

# パスワード再設定メールの送信(Resend: https://resend.com )
# 未設定の場合、送信はスキップされサーバーログにリンクが出力されるだけになる(開発用)
RESEND_API_KEY="re_..."
# 独自ドメイン未認証の場合は "onboarding@resend.dev" を使うとテスト送信できる
EMAIL_FROM="リバーサル <onboarding@resend.dev>"

# Google Analytics 4 測定ID(GA4管理画面のデータストリームで発行される "G-" 始まりの文字列)
# 未設定の場合、計測タグは埋め込まれない
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# GA4 Data API連携(管理ページのアクセス状況表示用)。以下の手順で取得する:
# 1. Google Cloud Consoleでプロジェクトを作成(または既存を選択)し、「Google Analytics Data API」を有効化する
# 2. 「IAM と管理」→「サービスアカウント」でサービスアカウントを新規作成し、キー(JSON形式)を作成・ダウンロードする
# 3. GA4管理画面の「プロパティのアクセス管理」で、ダウンロードしたJSON内のclient_emailを「閲覧者」として追加する
# 4. ダウンロードしたJSONファイルをBase64エンコードし、その文字列をGA4_SERVICE_ACCOUNT_JSON_BASE64に設定する
#    (PowerShellの例: [Convert]::ToBase64String([IO.File]::ReadAllBytes("path\to\key.json")))
# 5. GA4管理画面の「プロパティ設定」に表示される数字のプロパティIDをGA4_PROPERTY_IDに設定する
# 未設定の場合、管理ページのアクセス状況セクションは「未設定」エラーを表示するだけで、他の機能には影響しない
GA4_PROPERTY_ID="123456789"
GA4_SERVICE_ACCOUNT_JSON_BASE64="ここにBase64エンコードしたサービスアカウントJSONを貼る"
